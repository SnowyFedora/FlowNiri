# FlowNiri theme: Monochrome
# Hex values WITHOUT '#'. Every key must be unique inside a theme:
# theme-switcher.sh swaps colours by value, so duplicates would cascade.
NAME_RU="Монохром"
NAME_EN="Monochrome"
GTK_THEME_NAME=FlowNiri-monochrome

BG=1c1c1c
BG_HARD=141414
