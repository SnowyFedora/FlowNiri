BORDER=3d3d3d
FG=d0d0d0
FG_STRONG=f5f5f5
FG_DIM=b4b4b4
GRAY=8c8c8c
MUTED=6a6a6a
ACCENT=dedede
ACCENT_2=b9b9b9
RED=cf8c8c
RED_BRIGHT=e0a0a0
GREEN=9ec49e
GREEN_BRIGHT=b4d8b4
